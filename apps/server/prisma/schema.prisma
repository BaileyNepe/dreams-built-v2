// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Client {
    id            String    @id @default(cuid())
    name          String    @default("")
    color         String    @default("")
    xeroContactId String?   @unique @map("xero_contact_id")
    createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
    project       Project[]

    @@map("client")
}

model BlockedDate {
    id        String   @id @default(cuid())
    date      String   @unique @default("")
    details   String   @default("")
    createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
    deleted   Boolean  @default(false)

    @@map("blocked_date")
}

model Project {
    id         String   @id @default(cuid())
    updatedAt  DateTime @updatedAt @map("updated_at")
    createdAt  DateTime @default(now()) @map("created_at")
    deleted    Boolean  @default(false)
    address    String   @default("")
    area       Float    @default(0)
    city       String   @default("")
    color      String   @default("")
    endClient  String   @default("") @map("end_client")
    isInvoiced Boolean  @default(false) @map("is_invoiced")
    jobNumber  Int      @unique @map("job_number")
    clientId   String   @map("client_id")
    client     Client   @relation(fields: [clientId], references: [id])

    xeroProjectId String?   @unique @map("xero_project_id")
    xeroSyncedAt  DateTime? @map("xero_synced_at")

    timeEntry       TimeEntry[]
    projectSchedule ProjectSchedule[]
    projectFiles    ProjectFile[]
    jobSheet        JobSheet?

    @@map("project")
}

model JobSheet {
    id        String   @id @default(cuid())
    projectId String   @unique @map("project_id")
    // JobSheetData: walls, overrides, section items, notes (see @dreams-built/shared jobsheet types)
    data      Json
    // Frozen copy of the JobSheetRules the sheet computes with
    rules     Json
    revision  Int      @default(0)
    deleted   Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    project   Project            @relation(fields: [projectId], references: [id])
    snapshots JobSheetSnapshot[]

    @@map("job_sheet")
}

model JobSheetSnapshot {
    id          String   @id @default(cuid())
    jobSheetId  String   @map("job_sheet_id")
    version     Int
    label       String   @default("")
    // { data, rules, computed } — fully self-describing
    blob        Json
    createdById String?  @map("created_by_id")
    deleted     Boolean  @default(false)
    createdAt   DateTime @default(now()) @map("created_at")

    jobSheet  JobSheet @relation(fields: [jobSheetId], references: [id])
    createdBy User?    @relation(fields: [createdById], references: [id])

    @@unique([jobSheetId, version])
    @@map("job_sheet_snapshot")
}

model JobSheetRules {
    id        String   @id @default(cuid())
    name      String   @default("Default")
    // JobSheetRulesData: sizes, thicknesses, polystyrene policy
    data      Json
    isActive  Boolean  @default(true) @map("is_active")
    deleted   Boolean  @default(false)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("job_sheet_rules")
}

model ProjectFile {
    id                  String   @id @default(cuid())
    name                String
    url                 String?
    key                 String
    originalKey         String?
    originalSize        Int?
    originalContentType String?
    size                Int
    contentType         String   @map("content_type")
    isPinned            Boolean  @default(false) @map("is_pinned")
    isArchived          Boolean  @default(false) @map("is_archived")
    isOptimized         Boolean  @default(false)
    projectId           String   @map("project_id")
    uploadedAt          DateTime @default(now()) @map("uploaded_at")
    updatedAt           DateTime @updatedAt @map("updated_at")
    deleted             Boolean  @default(false)

    project Project @relation(fields: [projectId], references: [id])

    @@map("project_file")
}

model ProjectPart {
    id        String   @id @default(cuid())
    name      String   @default("")
    order     Int      @default(0)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    deleted   Boolean  @default(false)

    projectSchedule ProjectSchedule[]

    @@map("project_parts")
}

model ProjectSchedule {
    id            String @id @default(cuid())
    projectId     String @map("project_id")
    projectPartId String @map("project_part_id")

    startDate DateTime @map("start_date")
    endDate   DateTime @map("end_date")
    notes     String   @default("")
    deleted   Boolean  @default(false)

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    projectPart ProjectPart @relation(fields: [projectPartId], references: [id])
    project     Project     @relation(fields: [projectId], references: [id])

    @@map("project_schedule")
}

model User {
    id        String   @id @default(cuid())
    email     String   @default("")
    firstName String   @default("") @map("first_name")
    lastName  String   @default("") @map("last_name")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    image     String   @default("")
    deleted   Boolean  @default(false)

    hourlyRate     Float       @default(0) @map("hourly_rate")
    authId         String      @unique @map("auth_id")
    xeroEmployeeId String?     @unique @map("xero_employee_id")
    role           Role        @default(USER)
    lastActive     DateTime    @default(now()) @map("last_active") @db.Timestamptz(3)
    timeEntry      TimeEntry[]
    note           Note[]

    xeroTimesheetExports XeroTimesheetExport[]

    // Forum relations
    forumPosts    ForumPost[]
    forumComments ForumComment[]
    forumLikes    ForumLike[]
    forumViews    ForumView[]

    jobSheetSnapshots JobSheetSnapshot[]

    @@map("user")
}

enum Role {
    ADMIN
    MANAGER
    CONTRACTOR
    EMPLOYEE
    USER
}

model TimeEntry {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    userId    String   @map("user_id")
    projectId String   @map("project_id")
    weekStart String   @default("") @map("week_start")

    duration  Float
    startTime String @map("start_time")
    endTime   String @map("end_time")
    day       String

    deleted Boolean @default(false)

    project Project @relation(fields: [projectId], references: [id])
    user    User    @relation(fields: [userId], references: [id])

    @@map("time_entry")
}

model Note {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    day       String   @default("")
    message   String   @default("")
    weekStart String   @default("") @map("week_start")
    userId    String   @map("user_id")
    user      User     @relation(fields: [userId], references: [id])

    @@map("note")
}

// Singleton row (id = "singleton") holding the app-wide Xero OAuth connection.
// accessToken/refreshToken are AES-256-GCM encrypted (iv:tag:ciphertext, base64).
model XeroConnection {
    id                    String               @id @default("singleton")
    tenantId              String               @default("") @map("tenant_id")
    tenantName            String               @default("") @map("tenant_name")
    accessToken           String               @default("") @map("access_token")
    refreshToken          String               @default("") @map("refresh_token")
    accessTokenExpiresAt  DateTime?            @map("access_token_expires_at")
    scopes                String               @default("")
    status                XeroConnectionStatus @default(DISCONNECTED)
    defaultEarningsRateId String               @default("") @map("default_earnings_rate_id")
    connectedById         String?              @map("connected_by_id")
    createdAt             DateTime             @default(now()) @map("created_at")
    updatedAt             DateTime             @updatedAt @map("updated_at")

    @@map("xero_connection")
}

enum XeroConnectionStatus {
    DISCONNECTED
    CONNECTED
    ERROR
}

model XeroTimesheetExport {
    id                String           @id @default(cuid())
    userId            String           @map("user_id")
    weekStart         String           @map("week_start")
    xeroTimesheetId   String           @default("") @map("xero_timesheet_id")
    payrollCalendarId String           @default("") @map("payroll_calendar_id")
    periodStartDate   String           @default("") @map("period_start_date")
    periodEndDate     String           @default("") @map("period_end_date")
    status            XeroExportStatus @default(PUSHED)
    totalUnits        Float            @default(0) @map("total_units")
    // Snapshot of the timesheet lines sent to Xero, for audit/diffing
    lines             Json
    error             String           @default("")
    exportedById      String           @map("exported_by_id")
    createdAt         DateTime         @default(now()) @map("created_at")
    updatedAt         DateTime         @updatedAt @map("updated_at")

    user User @relation(fields: [userId], references: [id])

    @@unique([userId, weekStart])
    @@map("xero_timesheet_export")
}

enum XeroExportStatus {
    PUSHED
    APPROVED
    REVERSED
    FAILED
}

model Contact {
    id        String   @id @default(cuid())
    name      String   @default("")
    email     String   @default("")
    phone     String   @default("")
    message   String   @default("")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    deleted   Boolean  @default(false)
    isRead    Boolean  @default(false) @map("is_read")

    @@map("contact")
}

model ForumPost {
    id        String   @id @default(cuid())
    title     String
    content   String
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    deleted   Boolean  @default(false)
    userId    String   @map("user_id")
    user      User     @relation(fields: [userId], references: [id])

    comments ForumComment[]
    likes    ForumLike[]
    views    ForumView[]
    files    ForumFile[]

    @@map("forum_post")
}

model ForumComment {
    id        String    @id @default(cuid())
    content   String
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    deleted   Boolean   @default(false)
    userId    String    @map("user_id")
    postId    String    @map("post_id")
    user      User      @relation(fields: [userId], references: [id])
    post      ForumPost @relation(fields: [postId], references: [id])

    @@map("forum_comment")
}

model ForumLike {
    id        String    @id @default(cuid())
    createdAt DateTime  @default(now()) @map("created_at")
    userId    String    @map("user_id")
    postId    String    @map("post_id")
    user      User      @relation(fields: [userId], references: [id])
    post      ForumPost @relation(fields: [postId], references: [id])

    @@unique([userId, postId])
    @@map("forum_like")
}

model ForumView {
    id        String    @id @default(cuid())
    createdAt DateTime  @default(now()) @map("created_at")
    userId    String    @map("user_id")
    postId    String    @map("post_id")
    user      User      @relation(fields: [userId], references: [id])
    post      ForumPost @relation(fields: [postId], references: [id])

    @@unique([userId, postId])
    @@map("forum_view")
}

model ForumFile {
    id                  String   @id @default(cuid())
    name                String
    url                 String?
    key                 String
    originalKey         String?
    originalSize        Int?
    originalContentType String?
    size                Int
    contentType         String   @map("content_type")
    postId              String   @map("post_id")
    uploadedAt          DateTime @default(now()) @map("uploaded_at")
    updatedAt           DateTime @updatedAt @map("updated_at")
    deleted             Boolean  @default(false)

    post ForumPost @relation(fields: [postId], references: [id])

    @@map("forum_file")
}
